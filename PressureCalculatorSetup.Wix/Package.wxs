<?xml version="1.0" encoding="utf-8"?>
<!-- 260703Cl 追加: vdproj (PressureCalculatorSetup.vdproj) の WiX v7 等価再現。CSManager\CSManagerSetup.Wix\Package.wxs を移植。
     不可侵: UpgradeCode (旧 vdproj 継承) / per-user (LocalAppData) / framework-dependent / 出力名 PressureCalculator-setup.msi (x64)
     PressureCalculator 固有: native 不使用 (glfw3.dll は staging で除外、libxrl/Crystallography.Native は非同梱)。データベース同梱物なし。 -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="PressureCalculator" Manufacturer="Crystallography Software"
           Version="$(var.ProductVersion)"
           UpgradeCode="AB8CAB9D-1085-4D04-8812-8107672A0B5C"
           Scope="perUser" Language="1033" Compressed="yes">

    <SummaryInformation Description="PressureCalculatorSetup" />

    <!-- AllowSameVersionUpgrades: x64⇔arm64 の same-version cross-grade (同一 UpgradeCode・別 ProductCode) を許可。
         IgnoreLanguage: 旧 vdproj MSI は ProductLanguage=0 (neutral) のため言語不問で検出。
         旧 vdproj と異なりダウングレードはブロックする (仕様改善、兄弟アプリ同型)。 -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" IgnoreLanguage="yes"
                  Schedule="afterInstallInitialize"
                  DowngradeErrorMessage="A newer version of [ProductName] is already installed." />

    <!-- CompressionLevel high (ReciPro/PDIndexer/CSManager 実績: 既定 mszip より小さくなる) -->
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="AppIcon.ico" SourceFile="..\PressureCalculator\App.ico" />

    <!-- per-user 固定: %LocalAppData%\Crystallography Software\PressureCalculator (vdproj の DefaultLocation を踏襲) -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ManufacturerFolder" Name="Crystallography Software">
        <Directory Id="INSTALLFOLDER" Name="PressureCalculator">
          <!-- exe のみ明示 File (ショートカット/Launch CA の参照 Id を固定するため) -->
          <Component Id="MainExe">
            <File Id="PressureCalculatorExe" Source="!(bindpath.staging)\PressureCalculator.exe" KeyPath="yes" />
          </Component>
          <!-- 残り全部をワイルドカード収集 (staging の内容が正。exe は重複登録になるため除外) -->
          <Files Include="!(bindpath.staging)\**">
            <Exclude Files="!(bindpath.staging)\PressureCalculator.exe" />
          </Files>
        </Directory>
      </Directory>
    </StandardDirectory>

    <!-- ショートカット: デスクトップ + スタートメニュー (vdproj と同一の2箇所、icon は App.ico) -->
    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcutComp">
        <Shortcut Id="DesktopShortcut" Name="PressureCalculator" Target="[#PressureCalculatorExe]"
                  WorkingDirectory="INSTALLFOLDER" Icon="AppIcon.ico" />
        <RegistryValue Root="HKCU" Key="Software\Crystallography Software\PressureCalculator"
                       Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="VendorMenuFolder" Name="Crystallography Software">
        <Component Id="StartMenuShortcutComp">
          <Shortcut Id="StartMenuShortcut" Name="PressureCalculator" Target="[#PressureCalculatorExe]"
                    WorkingDirectory="INSTALLFOLDER" Icon="AppIcon.ico" />
          <RemoveFolder Id="RemoveVendorMenuFolder" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\Crystallography Software\PressureCalculator"
                         Name="startmenu" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- UI: WixUI_InstallDir (per-user 固定)。 -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <!-- LICENSE.rtf は wixproj 基準の相対パス (PressureCalculatorSetup.Wix\ 内、LICENSE.md から生成) -->
    <WixVariable Id="WixUILicenseRtf" Value="LICENSE.rtf" />

    <!-- 完了画面「Launch PressureCalculator」既定 ON (兄弟アプリ同型) -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch PressureCalculator" />
    <Property Id="WixShellExecTarget" Value="[#PressureCalculatorExe]" />
    <CustomAction Id="LaunchApp" DllEntry="WixShellExec" Impersonate="yes"
                  Execute="immediate" Return="check"
                  BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" />
    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApp"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
    </UI>

  </Package>
</Wix>
